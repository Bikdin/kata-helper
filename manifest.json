{
  "manifest_version": 3,
  "name": "KATA Helper",
  "version": "0.1.0",
  "description": "Группировка алертов KATA по технологии и объекту, Source/Destination IP. Запрос только по кнопке.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "KATA Helper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
